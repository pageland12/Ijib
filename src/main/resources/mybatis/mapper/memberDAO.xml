<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ijib.dao.IMemberDAO">
	<select id="memberList" resultType="com.springboot.ijib.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		 ORDER BY MNO DESC
	</select>
	
	<select id="findByEmail" resultType="com.springboot.ijib.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		 WHERE MEMAIL=#{memail}
 	</select>
 	
 	<select id="memberView" resultType="com.springboot.ijib.dto.MemberDTO">
		SELECT *
		  FROM MEMBER
		  WHERE mno = #{mno}
	</select>
	
	<insert id="memberInsert">
		INSERT INTO MEMBER(MNO,MEMAIL,MPASSWD,MNAME,MGENDER,MAGE,MADDR,MTEL,MACCOUNT,MAUTH,MSTATUS,MDATE)
		 VALUES(MEMBER_SEQ.NEXTVAL,#{memail},#{mpasswd},#{mname},#{mgender},#{mage},#{maddr},#{mtel},#{maccount},'NORMAL','ACTIVE',SYSDATE)
	</insert>
	
	<update id="memberUpdate">
		UPDATE MEMBER
		   SET MNAME=#{mname},MADDR=#{maddr},MTEL=#{mtel},MACCOUNT=#{maccount}
		 WHERE MNO=#{mno}
	</update>
	
	<delete id="memberDelete">
		DELETE FROM MEMBER
		 WHERE MNO=#{mno}
	</delete>
	
</mapper>

