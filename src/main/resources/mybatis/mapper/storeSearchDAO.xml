<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.ijib.dao.IStoreSearchDAO">

    <select id="searchStores" parameterType="com.springboot.ijib.dto.StoreSearchDTO" resultType="com.springboot.ijib.dto.StoreSearchDTO">
        SELECT * FROM store
        <where>
            <if test="keyword != null and keyword != ''">
                AND (sname LIKE '%' || #{keyword} || '%' OR scategory LIKE '%' || #{keyword} || '%')
            </if>
            <if test="scategory != null and scategory.size() > 0">
                AND 
                <foreach item="item" collection="scategory" open="(" separator=" OR " close=")">
                    scategory LIKE '%' || #{item} || '%'
                </foreach>
            </if>
            <if test="ssido != null and ssido != ''">
                AND ssido = #{ssido}
            </if>
            <if test="sparking != null and sparking != ''">
                AND sparking = #{sparking}
            </if>
        </where>
        ORDER BY sno ASC
    </select>

</mapper>